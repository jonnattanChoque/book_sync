{
  "@@locale": "en",
  "exportPreviewTitle": "Export Summary",
  "@exportPreviewTitle": {
    "description": "Title for the export preview sheet."
  },
  "exportContentToInclude": "Content to include",
  "@exportContentToInclude": {
    "description": "Label for the card selection section."
  },
  "exportBackgroundStyle": "Background Style",
  "@exportBackgroundStyle": {
    "description": "Label for the background selection section."
  },
  "exportGenerating": "Generating...",
  "@exportGenerating": {
    "description": "Button text while processing the snapshot."
  },
  "exportShareButton": "Share Image",
  "@exportShareButton": {
    "description": "Main button text to share the generated image."
  },
  "exportDefaultShareText": "My reading statistics with {appName}!",
  "@exportDefaultShareText": {
    "description": "Default text when sharing to apps."
  },
  "exportPremiumTitle": "Premium Feature",
  "@exportPremiumTitle": {
    "description": "Title of the modal inviting users to purchase Premium."
  },
  "exportPremiumDescription": "This exclusive background is part of {appName} Premium. Unlock all gradients, textures, and full customization for your shared images.",
  "@exportPremiumDescription": {
    "description": "Description of Premium benefits in the export modal."
  },
  "exportUpgradeButton": "Get Premium",
  "@exportUpgradeButton": {
    "description": "Button text to navigate to the purchase/subscription screen."
  },
  "exportCancelButton": "Maybe later",
  "@exportCancelButton": {
    "description": "Button text to dismiss the promotional modal."
  },
  "exportNoteTooltip": "Export note as image",
  "@exportNoteTooltip": {
    "description": "Tooltip for the note export button."
  },
  "exportNoteBy": "by {author}",
  "@exportNoteBy": {
    "description": "Indicates the book author in the note export card.",
    "placeholders": {
      "author": {
        "type": "String"
      }
    }
  },
  "exportNoteShareText": "A reading note from my current book with {appName}! 📖✨",
  "@exportNoteShareText": {
    "description": "Default text when sharing a reading note.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "BookSync"
      }
    }
  },
  "exportCalendarShareText": "My monthly reading calendar summary with {appName}! 📅📚",
  "@exportCalendarShareText": {
    "description": "Default text when sharing the monthly reading calendar.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "BookSync"
      }
    }
  },
  "exportStreakShareText": "My current reading streak on {appName}! 🔥📖",
  "@exportStreakShareText": {
    "description": "Default text when sharing the reading streak.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "BookSync"
      }
    }
  }
}
