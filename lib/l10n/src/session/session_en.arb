{
  "@@locale": "en",
  "newSession": "Read",
  "@newSession": {
    "description": "Button text to start a new reading session"
  },
  "readingHistory": "Reading History",
  "@readingHistory": {
    "description": "Header for reading sessions history section"
  },
  "noSessionsRegistered": "You haven't recorded any reading sessions yet.",
  "@noSessionsRegistered": {
    "description": "Message when no sessions are saved"
  },
  "pagesRange": "Pages {startPage} to {endPage}",
  "@pagesRange": {
    "description": "Range of read pages in a session",
    "placeholders": {
      "startPage": {
        "type": "int",
        "example": "10"
      },
      "endPage": {
        "type": "int",
        "example": "25"
      }
    }
  },
  "upToPage": "Up to page {endPage}",
  "@upToPage": {
    "description": "Text indicating end page when start page is missing",
    "placeholders": {
      "endPage": {
        "type": "int",
        "example": "50"
      }
    }
  },
  "readingSessionTitle": "Reading Session",
  "@readingSessionTitle": {
    "description": "Main title for active reading session screen"
  },
  "timerStart": "Start",
  "@timerStart": {
    "description": "Button label to start timer for the first time"
  },
  "timerResume": "Resume",
  "@timerResume": {
    "description": "Button label to resume paused timer"
  },
  "timerPause": "Pause",
  "@timerPause": {
    "description": "Button label to pause timer"
  },
  "finishSession": "Finish",
  "@finishSession": {
    "description": "Button to stop timer and record reading progress"
  },
  "finishReadingTitle": "Finish Reading",
  "@finishReadingTitle": {
    "description": "Modal title when ending a reading session"
  },
  "timeReadLabel": "Time Read",
  "@timeReadLabel": {
    "description": "Label displaying total session duration"
  },
  "minutesShort": "min",
  "@minutesShort": {
    "description": "Short form for minutes"
  },
  "secondsShort": "s",
  "@secondsShort": {
    "description": "Short form for seconds"
  },
  "whatPageDidYouReach": "What page did you reach?",
